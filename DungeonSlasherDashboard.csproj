<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DungeonSlasherDashboard</AssemblyName>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="web/index.html" LogicalName="index.html" />
    <EmbeddedResource Include="web/dashboard.css" LogicalName="dashboard.css" />
    <EmbeddedResource Include="web/dashboard.js" LogicalName="dashboard.js" />
    <EmbeddedResource Include="web/recommendations.js" LogicalName="recommendations.js" />
    <EmbeddedResource Include="web/unlock-routes.js" LogicalName="unlock-routes.js" />
    <EmbeddedResource Include="web/unlock-loadouts.js" LogicalName="unlock-loadouts.js" />
    <EmbeddedResource Include="web/loadouts.js" LogicalName="loadouts.js" />
    <EmbeddedResource Include="generated/icons.png" LogicalName="icons.png" />
    <EmbeddedResource Include="generated/catalog.json" LogicalName="catalog.json" />
  </ItemGroup>
  <Target Name="CheckGeneratedResources" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('generated/catalog.json') Or !Exists('generated/icons.png')"
           Text="게임 리소스가 필요합니다. 먼저 README의 tools/build_catalog.py 명령을 실행하세요." />
  </Target>
</Project>
